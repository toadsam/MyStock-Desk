# docker compose 가 읽는 값. 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다(.gitignore).

# --- 필수 ---------------------------------------------------------------
# MySQL. 앱은 root 가 아니라 MYSQL_USER 로 붙는다. 둘 다 새로 만든 긴 비밀번호를 넣는다.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# 토큰 서명 키. 32바이트 이상. 만들기: openssl rand -base64 48
STOCKFLOW_JWT_SECRET=

# --- 선택 ---------------------------------------------------------------
# 밖으로 여는 포트(nginx). 앞에 Caddy 같은 프록시를 두면 8080 처럼 바꾼다.
WEB_PORT=80
MYSQL_DATABASE=stockflow
MYSQL_USER=stockflow
# 화면과 API 를 다른 도메인에 둘 때만. 보통은 비워 둔다(nginx 가 같은 주소에서 /api 를 넘긴다).
VITE_API_BASE_URL=
STOCKFLOW_CORS_ALLOWED_ORIGINS=
# 구글 로그인. Google Cloud Console 의 OAuth 클라이언트 ID(웹 애플리케이션). 비밀이 아니다. 비우면 로그인 화면에 버튼이 안 뜬다.
GOOGLE_CLIENT_ID=
# false 면 이메일·비밀번호 가입과 로그인을 받지 않는다(구글 로그인만). 로그인 화면의 데모 버튼도 같이 꺼진다. 기본 true.
STOCKFLOW_PASSWORD_LOGIN_ENABLED=true
# 없으면 그 기능만 시드·규칙으로 내려가고 앱은 뜬다.
DART_API_KEY=
OPENAI_API_KEY=
SEC_USER_AGENT=StockFlow/1.0 contact@example.com
